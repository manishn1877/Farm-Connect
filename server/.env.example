# Copy to .env (local) or paste into your host's "Environment" page. Never commit real values.
PORT=8787
DB_PATH=/var/data/farmconnect.db        # must be on a persistent disk
TRUST_PROXY=1                           # 1 on Render, Railway, Fly, nginx
# ALLOWED_ORIGIN=                       # only if the website is hosted on a different address

# Admin login for /admin (you). Use a long password.
ADMIN_PHONE=9XXXXXXXXX
ADMIN_PASSWORD=change-this-to-a-long-passphrase

# Razorpay (start with test keys: rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# Phone codes. Without a provider, codes are only printed in the server log.
SMS_PROVIDER=msg91                      # msg91 | twilio | console
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=                      # DLT-registered template with ##message##
# TWILIO_SID= / TWILIO_TOKEN= / TWILIO_FROM=

# Shown on the Contact, Terms and footer pages
BUSINESS_NAME=FarmConnect
BUSINESS_ADDRESS=
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
GRIEVANCE_NAME=
GRIEVANCE_EMAIL=
FSSAI_NO=
GSTIN=

REQUIRE_OTP=1                           # phone code at sign-up and password reset
REQUIRE_APPROVAL=1                      # new sellers need your OK before customers see their produce
